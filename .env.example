# Copy to .env for local development. Production values live in `dokku config`.
NODE_ENV=development

# Local HTTPS certificates (required when NODE_ENV=development)
LOCALHOST_CERT=
LOCALHOST_CERT_AUTHORITY=
LOCALHOST_CERT_KEY=

# Minecraft PokemonServer SQLite DB (default /mcdata/pokemonserver.db)
MC_DB_PATH=

# Comma-separated dependencies this environment runs without on purpose (see dependencies.js)
# e.g. DEPENDENCIES_ABSENT=mcdb
DEPENDENCIES_ABSENT=
